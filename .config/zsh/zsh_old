# Arrays to track environment variables and aliases
local_env_vars=()
local_env_aliases=()

# Function to load .env or .zshrc in the current directory
load_local_env() {
    # Cleanup previously loaded directory-specific environment settings
    cleanup_local_env

    local local_env_file
    if [[ -f .env ]]; then
        local_env_file=".env"
    elif [[ -f .zshrc ]]; then
        local_env_file=".zshrc"
    else
        return
    fi

    # Source the environment file and track aliases/variables
    while IFS= read -r line; do
        # Check if the line defines an alias or environment variable
        if [[ $line == alias* ]]; then
            eval "$line"
            local_env_aliases+=("${line#alias }")
        elif [[ $line == *'='* ]]; then
            eval "$line"
            local_env_vars+=("${line%%=*}")
        fi
    done < "$local_env_file"
}

# Function to unset local aliases and variables when leaving the directory
cleanup_local_env() {
    for alias_name in "${local_env_aliases[@]}"; do
        unalias "${alias_name%%=*}" 2>/dev/null
    done
    for var_name in "${local_env_vars[@]}"; do
        unset "$var_name" 2>/dev/null
    done
    # Clear the arrays after cleanup
    local_env_aliases=()
    local_env_vars=()
}

# Automatically load .env or .zshrc when changing directories
autoload -Uz add-zsh-hook
add-zsh-hook chpwd load_local_env

# Load .env or .zshrc on the first shell start
load_local_env

# Function to open projects with Zellij
dev() {
    local search_term="$1"
    local dev="$HOME/Developer"
    local dirs=($(find $dev -type d -maxdepth 2 -mindepth 2 -iname "$search_term*"))

    if [ -n "$search_term" ]; then
        if [ "${#dirs[@]}" -gt 0 ]; then
            cd ${dir[1]}
        else
            echo "Error: Project with name starting with '$search_term' not found in '$dev'"
            echo '$dev'
        fi
    else
        echo "Error: Search term not provided"
    fi
}

# Completion function for dev
_dev_completion() {
    _arguments \
        "1: :->search_term" \
        && return

    case "$state" in
        search_term)
            _values "search_terms" $(find "$HOME/Developer" -maxdepth 2 -mindepth 2 -type d -exec basename {} \;) && return
            ;;
    esac
}

# Enable completion for the dev function
compdef _dev_completion dev

