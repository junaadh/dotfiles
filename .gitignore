# ignore all
/*

# unignore zshrc
!.zshrc
!.zshenv
!.zprofile

# unignore .config
!.config/

# ignore .DS_Store
*/.DS_Store

# unignore README
!README.md

# unignore .gitignore
!.gitignore

# unignore hushlogin
!.hushlogin

# ignore runtimes
.config/helix/runtime

# ignore tmux plugins
.config/tmux/plugins

# ignore zsh_history
.config/zsh/.zsh_history  

# ignore zsh sessions
.config/zsh/.zsh_sessions/

# unignore nushell config
!Library/
Library/*

!Library/Application Support/
Library/Application Support/*

!Library/Application Support/nushell/
Library/Application Support/nushell/*

!Library/Application Support/nushell/**

# rustfmt config
!.rustfmt.toml
